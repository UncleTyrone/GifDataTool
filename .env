# Copy to .env and fill in. Used by `python-dotenv` when running `streamlit run app.py`.

ROBLOX_API_
ROBLOX_USER_ID=346578049

# Optional — if set, uploads are owned by this group instead of the user.
# ROBLOX_GROUP_ID=
ROBLOX_GROUP_ID=148209227

# Optional — default path to the Lua module to patch (same as the main text box).
# GIFDATA_LUA_PATH=

# Optional — on Streamlit Community Cloud: add GIFDATA_PUBLIC_DEPLOY=1 to Secrets (or set here for local).
# Hides “save .env on server” and “patch file on disk” for visitors; browser localStorage still works.
# GIFDATA_PUBLIC_DEPLOY=1