# Optional server-side defaults when running locally (`python-dotenv` loads this).
# The hosted app saves credentials per visitor in the browser (localStorage), not here.

ROBLOX_API_KEY=
ROBLOX_USER_ID=

# Optional — if set, uploads are owned by this group instead of the user.
# ROBLOX_GROUP_ID=

# Optional — default path to the Lua module to patch (same as the sidebar disk path when running locally).
# GIFDATA_LUA_PATH=

# Optional — Streamlit Community Cloud: set GIFDATA_PUBLIC_DEPLOY=1 in app Secrets (TOML), or uncomment locally.
# Hides "Advanced: write .env on the server" and "patch file on disk" for visitors; per-browser credentials unchanged.
# GIFDATA_PUBLIC_DEPLOY=1

# Optional — force those panels visible again when debugging (overrides auto-hide). Normally unset.
# GIFDATA_SHOW_LOCAL_DISK_UI=1
